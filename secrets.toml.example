# Copy to .streamlit/secrets.toml and fill in. Never commit secrets.toml.
# Every key can also be supplied as an environment variable of the same name.

# Price API (Metals-API style timeseries endpoint)
METALS_API_BASE_URL = "https://metals-api.com/api"
METALS_API_KEY = "your-metals-api-key"

# Timestral-28M zero-shot forecasting backend
TIMESTRAL_API_URL = "https://timestral.internal.example.com"
TIMESTRAL_API_KEY = "your-timestral-token"
TIMESTRAL_MODEL = "timestral-28m"
